<div class="container">
    <div class="meta">
        <div class="type">
            <%= is_category() ? __('category') : '' %>
            <%= is_tag() ? __('tag') : '' %>
        </div>

        <h2 class="title<%= theme.capitalize_tags && is_tag() ? ' text-capitalize' : '' %>"><%= is_category() ? page.category : '' %><%= is_tag() ? (theme.hashtag_prefix_before_tags ? '#' : '') + page.tag : '' %><%= is_archive() ? __('archives') : '' %></h2>
        <p class="count"><%= __('posts_count', is_archive() && !is_month() && !is_year() ? site.posts.length : page.posts.length) %></p>
    </div>

    <div class="divider"></div>

    <div class="post-list archives">
        <% var lastYear = null %>
        <% page.posts.each(function (post) { %>
        <% if (post.date.year() !== lastYear) { lastYear = post.date.year() %>
        <h3 class="year"><%= lastYear %></h3>
        <% } %>
        <article class="post-list-item">
            <a href="<%- url_for(post.path) %>">
                <span class="date"><%= date(post.date, 'MM-DD') %></span>
                <span class="title"><%= post.title %></span>
                <% if (post.tags && post.tags.length) { %>
                <span class="tags-inline"><%= post.tags.map(t => t.name).join(' · ') %></span>
                <% } %>
            </a>
        </article>
        <% }) %>
    </div>

    <%- partial('_partial/paginator') %>
</div>
