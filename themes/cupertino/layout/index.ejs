<div class="container">
    <% if (page.path == "index.html") { %>
    <div class="hero">
        <div class="group">
            <p class="eyebrow"><%= config.title %></p>
            <h1 class="large"><%- config.description %></h1>
            <p class="sub"><%= config.subtitle %></p>
            <div class="actions">
                <a class="button" href="#latest"><%= __('latest_posts') %></a>
                <a class="link" href="<%- url_for(config.archive_dir) %>/"><%= __('all_posts') %></a>
            </div>
        </div>
    </div>

    <div class="section-header" id="latest">
        <h2 class="section-title"><%= __('latest_posts') %></h2>
        <a class="section-link" href="<%- url_for(config.archive_dir) %>/"><%= __('posts_count', site.posts.length) %></a>
    </div>
    <% } %>

    <div class="post-list<%= page.current == 1 ? ' home' : '' %>">
        <% page.posts.each(function (post) { %>
        <%- partial('_partial/post-card', { post: post }) %>
        <% }) %>
    </div>

    <%- partial('_partial/paginator') %>
</div>
