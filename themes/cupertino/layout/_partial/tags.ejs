<div class="container">
    <div class="meta">
        <h2 class="title"><%= __('tags') %></h2>
        <p class="count"><%= __('posts_count', site.posts.length) %></p>
    </div>
    <div class="divider"></div>
    <div class="tags">
        <% site.tags.sort('name').forEach((tag) => { %>
        <a href="<%= url_for(tag.path) %>" class="tag reveal"><%= theme.hashtag_prefix_before_tags ? '#' : '' %><%= tag.name %><span class="count"><%= tag.length %></span></a>
        <% }) %>
    </div>
</div>
