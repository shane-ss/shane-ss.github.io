<footer>
    <div class="inner">
        <div class="copyright">
            <span>&copy; <%= date(new Date(), 'YYYY') %> <%= config.author || config.title %></span><span class="sep">|</span><span><%- __('powered_by', '<a href="https://hexo.io/" target="_blank" rel="noopener">Hexo</a>') %></span>
            <% if (theme.footer_extra_description) { %>
            <span class="footer-extra-description"><%- theme.footer_extra_description %></span>
            <% } %>
        </div>
        <% if (theme.show_color_scheme_toggle) { %>
        <div class="color-scheme-toggle" role="radiogroup" id="theme-color-scheme-toggle">
            <label>
                <input type="radio" value="light">
                <span><%= __('scheme_light') %></span>
            </label>
            <label>
                <input type="radio" value="dark">
                <span><%= __('scheme_dark') %></span>
            </label>
            <label>
                <input type="radio" value="auto">
                <span><%= __('scheme_auto') %></span>
            </label>
        </div>
        <% } %>
    </div>
</footer>
